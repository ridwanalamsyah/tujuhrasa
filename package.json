{
  "name": "tujuhrasa-mono",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tujuhrasa/web",
    "dev:erp": "npm run dev --workspace @tujuhrasa/erp",
    "build": "npm run build --workspace @tujuhrasa/web",
    "build:erp": "npm run build --workspace @tujuhrasa/erp",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "setup": "npm install && npm run setup --workspace @tujuhrasa/web"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
