# ─── Database (production: Postgres / development: SQLite) ───
# Production (Vercel + Supabase Postgres): pakai pooler URL untuk runtime
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Production: direct (port 5432) untuk prisma migrate / db push
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Development (SQLite, optional fallback):
# DATABASE_URL="file:./prisma/dev.db"

# ─── ERP integration (Supabase kv_store on Tujuh Rasa ERP project) ───
ERP_SUPABASE_URL="https://epakwpgryncocqwmslod.supabase.co"
ERP_SUPABASE_ANON_KEY="<anon key dari ERP Supabase, public di client ERP>"
ERP_STATE_KEY="tr_erp_v3:state"
ERP_TABLE="kv_store"
ERP_BATCH_NAME="Batch Mei 2026"
# Set to "false" untuk matikan ERP push (local-only development)
ERP_SYNC_ENABLED="true"

# ─── Admin gate ───
ADMIN_PASSWORD="tujuhrasa"
# Rahasia HMAC token. Wajib diisi panjang & random untuk production.
ADMIN_SESSION_SECRET=""
