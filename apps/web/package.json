{
  "name": "@tujuhrasa/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-erp.mjs && next dev -p 3000",
    "build": "node scripts/copy-erp.mjs && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push --accept-data-loss --skip-generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "tsx prisma/seed-prod.ts",
    "setup": "prisma generate && prisma db push --accept-data-loss && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@tujuhrasa/shared": "*",
    "@tujuhrasa/supabase": "*",
    "@tujuhrasa/ui": "*",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.55.0",
    "next": "^15.5.27",
    "pg": "^8.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.27",
    "postcss": "^8.4.47",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
